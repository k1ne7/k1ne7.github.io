---
interface Props {
  post: {
    id: string;
    data: {
      title: string;
      date: Date;
      category?: string;
      excerpt?: string;
      cover?: string;
    };
  };
}

const { post } = Astro.props;
const { data } = post;
const href = `/blog/${post.id}/`;

const date = data.date.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
---

<li>
  <article class:list={['card', { 'no-cover': !data.cover }]}>
    {
      data.cover && (
        <div class="card-cover">
          <img
            src={data.cover}
            alt=""
            width="464"
            height="290"
            loading="lazy"
            decoding="async"
          />
        </div>
      )
    }

    <div class="card-body">
      <div class="card-meta">
        <time datetime={data.date.toISOString()}>{date}</time>
        {data.category && <span class="chip">{data.category}</span>}
      </div>

      <h2 class="card-title">
        <a class="card-link" href={href}>{data.title}</a>
      </h2>

      {data.excerpt && <p class="card-excerpt">{data.excerpt}</p>}
    </div>
  </article>
</li>
